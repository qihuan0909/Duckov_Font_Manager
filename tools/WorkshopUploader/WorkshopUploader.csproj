<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone Steam Workshop uploader. Uses the game's own Steamworks.NET and steam_api64.dll
       (not redistributed: copied from the local game install at build time). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(DuckovManaged)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(DuckovPath)\Duckov_Data\Plugins\x86_64\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
